# Copy this file to backend/.env and fill in your values
# backend/.env is gitignored — never commit it

# Google Sheet ID for portfolio sync
# Your sheet must be publicly readable (Share → Anyone with the link → Viewer)
# Find the ID in your sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GSHEET_ID=your_google_sheet_id_here

# Telegram notifications
# Defaults can be inherited from ~/.hn-daily-digest/.env:
# TELEGRAM_TOKEN=...
# ADMIN_ID=...
# Or configure explicitly for stock-radar:
# TELEGRAM_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# Claude API — daily post-market analysis
# Get your key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Path to Mimi strategy doc (Obsidian markdown)
MIMI_DOC_PATH=/Users/yankesswang/Documents/arthurwang_DB/投資/mimi操作建議總表.md
